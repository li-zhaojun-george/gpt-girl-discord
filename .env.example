# Required: a Discord bot token and explicit channel IDs.
DISCORD_BOT_TOKEN=
ALLOWED_CHANNEL_IDS=
# mention: Discord mention/reply only; observe: addressed + ongoing conversation; social: selective interjections.
BOT_MODE=mention
# Required to observe ordinary messages: enable Message Content Intent in Discord too.
OBSERVED_CHANNEL_IDS=
MODEL_BACKEND=codex
# Use native executable (Windows: full path to codex.exe), not a .cmd wrapper.
CODEX_EXECUTABLE=codex
# Blank uses CLI default model. Check access with your deployment account.
CODEX_MODEL=
# disabled (default), cached, or live. Enables hosted search only; no shell/browser access.
CODEX_WEB_SEARCH=disabled
BOT_TIMEZONE=America/Toronto
# -1: no local daily cap; 0: disabled; positive: daily cap. Counters persist in every mode.
DAILY_MODEL_CALLS=-1
DAILY_SOCIAL_CALLS=-1
# Only limits unsolicited interjections; addressed turns and followups bypass it.
SOCIAL_COOLDOWN_SECONDS=30
CONVERSATION_WINDOW_SECONDS=180
MESSAGE_DEBOUNCE_SECONDS=1.5
BOT_ALIASES=GPT娘,大白龙,龙娘,小龙
QUIET_START_HOUR=23
QUIET_END_HOUR=8
# Only for explicit MODEL_BACKEND=openai. No automatic paid fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

